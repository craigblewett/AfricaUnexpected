{
  "kind": "collectionType",
  "collectionName": "stays",
  "info": {
    "singularName": "stay",
    "pluralName": "stays",
    "displayName": "Stay"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "location": {
      "type": "string"
    },
    "recommendedStay": {
      "type": "string"
    },
    "priceRange": {
      "type": "string"
    },
    "bestSeason": {
      "type": "enumeration",
      "enum": [
        "Summer",
        "Autumn",
        "Winter",
        "Spring",
        "Year-round"
      ]
    },
    "teaser": {
      "type": "string"
    },
    "overview": {
      "type": "richtext"
    },
    "howToGetThere": {
      "type": "richtext"
    },
    "whatToPack": {
      "type": "richtext"
    },
    "tipsSafety": {
      "type": "string"
    },
    "coverImage": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": false,
      "required": true
    },
    "gallery": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": true
    },
    "tier": {
      "type": "enumeration",
      "enum": [
        "free",
        "tier-1",
        "tier-2",
        "tier-3"
      ]
    },
    "affiliateUrl": {
      "type": "string",
      "required": true
    },
    "downloadPdf": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": true
    }
  }
}
