{
  "collectionName": "itineraries",
  "info": {
    "singularName": "itinerary",
    "pluralName": "itineraries",
    "displayName": "Itinerary"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title":          { "type": "string", "required": true },
    "slug":           { "type": "uid", "targetField": "title", "required": true },
    "region":         { "type": "enumeration", "enum": ["Cape Town","Garden Route","Winelands","West Coast","Overberg"] },
    "days":           { "type": "integer" },
    "theme":          { "type": "enumeration", "enum": ["budget","romance","family","surf","wine"] },
    "overview":       { "type": "richtext" },
    "coverImage":     { "type": "media", "multiple": false, "required": true },
    "downloadPdf":    { "type": "media", "multiple": false },
    "tier":           { "type": "enumeration", "enum": ["spark","live","wild"], "default": "spark" },
    "tags":           { "type": "string", "repeatable": true }
  }
}

